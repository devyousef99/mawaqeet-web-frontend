# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are intentionally unrooted (no leading "/") so they match at every
# level of the monorepo: apps/*/.next, packages/*/node_modules, etc.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# caches
.turbo/
.cache/
.eslintcache
*.tsbuildinfo

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# editors
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
