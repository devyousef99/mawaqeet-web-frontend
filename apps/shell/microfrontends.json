{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "shell": {
      "packageName": "@mawaqeet/shell",
      "development": {
        "local": 4100,
        "fallback": "mawaqeet-shell.vercel.app"
      }
    },
    "admin": {
      "packageName": "@mawaqeet/admin",
      "development": { "local": 4101 },
      "routing": [{ "paths": ["/admin/:path*"] }]
    },
    "provider": {
      "packageName": "@mawaqeet/provider",
      "development": { "local": 4102 },
      "routing": [{ "paths": ["/provider/:path*"] }]
    }
  }
}
